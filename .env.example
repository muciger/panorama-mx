# Variables de entorno del pipeline. Copia a .env local y rellena.
# En GitHub Actions van como Secrets, no subir .env real.

# API key de Anthropic para generar interpretaciones (Paso 3).
# Obtener en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo por default para interpretaciones.
ANTHROPIC_MODEL=claude-sonnet-4-6
