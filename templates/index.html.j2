{% extends "base.html.j2" %}
{% block content %}

{# ─── HERO INSTITUCIONAL ───────────────────────────────────────────────── #}
<header class="h2-page-header">
  <div class="h2-page-eyebrow">Secretaría de Economía · {{ topbar_fecha }}</div>
  <h1 class="h2-page-title">Panorama MX, indicadores económicos clave</h1>
  <p class="h2-page-sub">Seguimiento de coyuntura económica de México para la Secretaría de Economía. 32 series oficiales BIE-INEGI actualizadas diariamente: actividad, precios, empleo, sector externo, inversión y sentimiento empresarial.</p>
</header>

{# ─── PUBLICACIONES DE HOY ─────────────────────────────────────────────── #}
<div class="h2-pub-strip">
  <div class="h2-pub-head">
    <span class="h2-pub-title">
      Publicaciones de hoy
      <span class="h2-pub-count">{{ publicaciones | length }}</span>
    </span>
    <a href="https://www.inegi.org.mx/app/saladeprensa/calendario/" target="_blank" rel="noopener" class="h2-pub-link">
      Ver calendario →
    </a>
  </div>
  <div class="h2-pub-chips">
    {% if not publicaciones %}
    <div class="h2-pub-empty">
      Sin publicaciones programadas hoy.
      <a href="https://www.inegi.org.mx/app/saladeprensa/calendario/" target="_blank" rel="noopener">Ver calendario INEGI →</a>
    </div>
    {% endif %}
    {% for p in publicaciones %}
    <a class="h2-pub-chip" href="{{ asset_prefix }}{{ 'imss_explorador.html' if p.iid == 'empleo_imss' else 'indicador/' ~ p.iid ~ '.html' }}">
      <span class="h2-chip-hora">{{ p.hora }}</span>
      <span class="h2-chip-name">{{ p.nombre }}</span>
      <span class="h2-chip-badge {% if p.es_hoy %}badge-pub{% else %}badge-prog{% endif %}">
        {% if p.es_hoy %}● Publicado{% else %}○ Programado{% endif %}
      </span>
    </a>
    {% endfor %}
  </div>
</div>

{# ─── HERO CHART ────────────────────────────────────────────────────────── #}
{% if hero %}
<div class="h2-hero">
  <div class="h2-hero-left">
    <div>
      <div class="h2-hero-eyebrow">Actividad económica global · IGAE</div>
      <div class="h2-hero-number {% if hero.delta_dir == 'up' %}pos{% elif hero.delta_dir == 'down' %}neg{% endif %}">
        {{ hero.valor_fmt }}<span class="h2-hero-unit">%</span>
      </div>
      <div class="h2-hero-name">Variación anual</div>
      <div class="h2-hero-period">{{ hero.periodo_label }}</div>
    </div>
    <div class="h2-hero-delta {% if hero.delta_dir == 'up' %}pos{% elif hero.delta_dir == 'down' %}neg{% endif %}">
      {% if hero.delta_dir == 'up' %}↑{% elif hero.delta_dir == 'down' %}↓{% else %}→{% endif %}
      {{ hero.delta_fmt }} respecto al periodo anterior
    </div>
  </div>
  <div class="h2-hero-right">
    <div class="h2-chart-label">IGAE — 24 MESES · VAR. %</div>
    <svg viewBox="0 0 580 130" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-svg-title">
      <title id="hero-svg-title">{{ hero.aria_label }}</title>
      <defs>
        <linearGradient id="hero-grad-pos" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#16A34A" stop-opacity="0.15"/>
          <stop offset="100%" stop-color="#16A34A" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="hero-grad-neg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#DC2626" stop-opacity="0"/>
          <stop offset="100%" stop-color="#DC2626" stop-opacity="0.12"/>
        </linearGradient>
      </defs>
      <line x1="20" y1="10" x2="560" y2="10" stroke="#E4E4E7" stroke-width="0.5" stroke-dasharray="3,3"/>
      <line x1="20" y1="37" x2="560" y2="37" stroke="#E4E4E7" stroke-width="0.5" stroke-dasharray="3,3"/>
      <line x1="20" y1="64" x2="560" y2="64" stroke="#E4E4E7" stroke-width="0.5" stroke-dasharray="3,3"/>
      <line x1="20" y1="100" x2="560" y2="100" stroke="#E4E4E7" stroke-width="1"/>
      {% if hero.y_zero is not none %}
      <line x1="20" y1="{{ hero.y_zero }}" x2="560" y2="{{ hero.y_zero }}"
            stroke="#52525B" stroke-width="1" stroke-dasharray="5,3"/>
      <text x="14" y="{{ hero.y_zero|float + 3 }}"
            font-family="'JetBrains Mono',ui-monospace,monospace"
            font-size="9" fill="#52525B" text-anchor="end">{{ hero.y_zero_label }}</text>
      {% endif %}
      <text x="14" y="13" font-family="'JetBrains Mono',ui-monospace,monospace"
            font-size="9" fill="#71717A" text-anchor="end">{{ hero.ymax_fmt }}</text>
      <text x="14" y="100" font-family="'JetBrains Mono',ui-monospace,monospace"
            font-size="9" fill="#71717A" text-anchor="end">{{ hero.ymin_fmt }}</text>
      {% if hero.pts %}
      <path d="M {{ hero.pts }} L560,100 L20,100 Z"
            fill="url(#hero-grad-{% if hero.delta_dir == 'up' %}pos{% else %}neg{% endif %})" />
      <polyline points="{{ hero.pts }}"
        fill="none"
        stroke="{% if hero.delta_dir == 'up' %}#16A34A{% elif hero.delta_dir == 'down' %}#DC2626{% else %}#71717A{% endif %}"
        stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="{{ hero.last_x }}" cy="{{ hero.last_y }}" r="4"
        fill="{% if hero.delta_dir == 'up' %}#16A34A{% elif hero.delta_dir == 'down' %}#DC2626{% else %}#71717A{% endif %}"/>
      <circle cx="{{ hero.last_x }}" cy="{{ hero.last_y }}" r="7"
        fill="none"
        stroke="{% if hero.delta_dir == 'up' %}#16A34A{% elif hero.delta_dir == 'down' %}#DC2626{% else %}#71717A{% endif %}"
        stroke-width="1" opacity="0.3"/>
      {% endif %}
      {% for lbl in hero.x_labels %}
      <text x="{{ lbl.x }}" y="122"
            font-family="'JetBrains Mono',ui-monospace,monospace"
            font-size="9"
            fill="{% if lbl.is_last %}#7C3AED{% else %}#71717A{% endif %}"
            text-anchor="middle"
            {% if lbl.is_last %}font-weight="500"{% endif %}>{{ lbl.label }}</text>
      {% endfor %}
    </svg>
  </div>
</div>
{% endif %}

{# ─── KPI STRIP ─────────────────────────────────────────────────────────── #}
<div class="h2-kpi-strip">
  {% for k in kpis %}
  <a class="h2-kpi-tile" href="{{ asset_prefix }}{{ 'imss_explorador.html' if k.id == 'empleo_imss' else 'indicador/' ~ k.id ~ '.html' }}"
     aria-label="Ver detalle de {{ k.etiqueta }}">
    <div class="h2-kpi-k">{{ k.etiqueta }}</div>
    <div class="h2-kpi-v {% if k.delta_dir == 'up' %}pos{% elif k.delta_dir == 'down' %}neg{% endif %}">
      {{ k.valor_fmt }}<span class="h2-kpi-u">{% if k.unidad != "%" %}{{ k.unidad }}{% endif %}</span>
    </div>
    {% if k.hom_pct is defined %}
    <div class="h2-kpi-genero">
      <span class="h2-kpi-hom">♂ {{ k.hom_pct }}%</span>
      <span>·</span>
      <span class="h2-kpi-muj">♀ {{ k.muj_pct }}%</span>
    </div>
    {% else %}
    <div class="h2-kpi-d {% if k.delta_dir == 'up' %}pos{% elif k.delta_dir == 'down' %}neg{% endif %}">
      {{ k.delta_arrow }} {{ k.delta_texto }}
    </div>
    {% endif %}
    <div class="h2-kpi-period">{{ k.periodo_label }}</div>
    {% if k.spark_svg %}
    <div class="h2-kpi-spark">{{ k.spark_svg | safe }}</div>
    {% endif %}
  </a>
  {% endfor %}
</div>

{# ─── RESUMEN DE COYUNTURA ───────────────────────────────────────────────── #}
{% if synthesis and synthesis.parrafos %}
<div class="h2-coyuntura-card">
  <div class="h2-coyuntura-head">
    <span class="h2-coyuntura-title">Lectura de coyuntura</span>
    {% if synthesis.titulo %}
    <span class="h2-coyuntura-fecha">{{ synthesis.titulo }}</span>
    {% endif %}
    <a href="{{ asset_prefix }}reporte.html" class="h2-coyuntura-link">Ver reporte completo →</a>
  </div>
  <div class="h2-coyuntura-body">
    {% for p in synthesis.parrafos %}
    <p class="h2-coyuntura-p">{{ p }}</p>
    {% endfor %}
  </div>
</div>
{% endif %}

{# ─── CATEGORY GROUPS ───────────────────────────────────────────────────── #}
<div class="h2-section-row">
  <span class="h2-section-title">Indicadores por categoría</span>
  <span class="h2-section-sub">32 series · BIE-INEGI</span>
</div>
<div class="h2-cat-grid">
  {% for grp in cat_groups %}
  <div class="h2-cat-card">
    <div class="h2-cat-head">
      <span class="h2-cat-name">{{ grp.nombre }}</span>
      <span class="h2-cat-n">{{ grp.rows | length }}</span>
    </div>
    {% for r in grp.rows %}
    <a class="h2-cat-row" href="{{ asset_prefix }}{{ r.href if r.href else 'indicador/' ~ r.iid ~ '.html' }}"
       aria-label="{{ r.nombre }}">
      <span class="h2-cat-row-name">{{ r.nombre }}</span>
      <span class="h2-cat-row-val {% if r.delta_dir == 'up' %}pos{% elif r.delta_dir == 'down' %}neg{% endif %}">
        {{ r.valor_fmt }}
      </span>
      <span class="h2-cat-row-d {% if r.delta_dir == 'up' %}pos{% elif r.delta_dir == 'down' %}neg{% endif %}">
        {{ r.delta_fmt }}
      </span>
      <div class="h2-cat-row-spark">{{ r.spark_svg | safe }}</div>
    </a>
    {% endfor %}
  </div>
  {% endfor %}
</div>

{# ─── TABLA COMPLETA + LATERAL ──────────────────────────────────────────── #}
<div class="h2-section-row">
  <span class="h2-section-title">Todos los indicadores</span>
  <a href="comparar.html" class="h2-section-link">Ver análisis comparativos →</a>
</div>
<div class="h2-bottom-layout">

  <div class="h2-tbl-card">
    <div class="h2-tbl-head">
      <span class="h2-tbl-title">Indicadores económicos</span>
      <div class="h2-tbl-actions">
        <div class="indic-search" style="min-width:160px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke-width="2"/>
            <path d="M21 21l-5-5" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <input id="tbl-search-v3" type="search" placeholder="Buscar" aria-label="Buscar indicador">
        </div>
        <select id="tbl-cat-filter" class="indic-btn" aria-label="Filtrar por categoría"
                style="appearance:auto;padding-right:10px">
          <option value="">Todas</option>
          {% set cats_seen = [] %}
          {% for r in tabla_rows %}
            {% if r.categoria and r.categoria not in cats_seen %}
              {% set _ = cats_seen.append(r.categoria) %}
              <option value="{{ r.categoria }}">{{ r.categoria | capitalize }}</option>
            {% endif %}
          {% endfor %}
        </select>
        <a href="{{ asset_prefix }}data/tabla_resumen.csv" download class="indic-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M12 4v12M7 11l5 5 5-5M5 20h14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          CSV
        </a>
      </div>
    </div>
    <div class="indic-tbl-wrap">
      <table class="indic-tbl" id="indic-tbl-v3">
        <thead>
          <tr>
            <th>Indicador</th>
            <th>Periodo</th>
            <th class="num">Valor</th>
            <th class="num">Variación</th>
          </tr>
        </thead>
        <tbody>
          {% for r in tabla_rows %}
          <tr class="indic-row" data-nombre="{{ r.nombre|lower }}" data-categoria="{{ r.categoria }}">
            <td class="indic-row-name">
              <a class="indic-row-link" href="{{ asset_prefix }}{{ r.href if r.href else 'indicador/' ~ r.iid ~ '.html' }}"
                 aria-label="Ver detalle de {{ r.nombre }}">
                <strong>{{ r.nombre }}</strong>
              </a>
            </td>
            <td class="muted">{{ r.periodo_label }}</td>
            <td class="num">{{ r.valor_fmt }}</td>
            <td class="num">
              <div class="cell-delta delta-{{ r.delta_dir }}">
                <span class="delta-arrow" aria-hidden="true">{{ r.delta_arrow }}</span>
                <span>{{ r.delta_fmt }}</span>
              </div>
              <div class="delta-sub">{{ r.var_label }}</div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="h2-side-col">
    <div class="h2-side-card">
      <div class="h2-side-head">Próximas publicaciones</div>
      {% if publicaciones %}
        {% for p in publicaciones %}
        <a class="h2-side-row" href="{{ asset_prefix }}{{ 'imss_explorador.html' if p.iid == 'empleo_imss' else 'indicador/' ~ p.iid ~ '.html' }}">
          <div>
            <div class="h2-side-name">{{ p.nombre }}</div>
            <div class="h2-side-sub">{{ p.fecha_label }}</div>
          </div>
          <span class="h2-side-badge {% if p.es_hoy %}badge-pub{% else %}badge-prog{% endif %}">
            {% if p.es_hoy %}Hoy{% else %}Próx.{% endif %}
          </span>
        </a>
        {% endfor %}
      {% else %}
        <div class="h2-side-empty">Sin publicaciones próximas.</div>
      {% endif %}
      <a href="https://www.inegi.org.mx/app/saladeprensa/calendario/" target="_blank" rel="noopener"
         class="h2-side-foot">Ver calendario completo →</a>
    </div>
  </div>

</div>

{% endblock %}
