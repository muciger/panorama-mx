{% if d._tile_map_svg %}
<section class="tile-map-card">
  <header class="card-head">
    <h3>{% if d.id == "empleo_imss" %}Empleo formal por entidad federativa{% else %}Mapa por entidad federativa{% endif %}</h3>
    <div class="source">{{ d._periodo_tabular }} · {% if d.id == "empleo_imss" %}IMSS datos abiertos{% else %}BIE-INEGI{% endif %}</div>
  </header>
  <div class="tile-map-wrap">
    {{ d._tile_map_svg | safe }}
  </div>
  {% if d.id == "empleo_imss" and d._entidad_filas %}
  <div style="margin-top:18px;overflow-x:auto">
    <table class="componentes-emoe-tbl" style="font-size:12.5px">
      <thead>
        <tr>
          {% for col in d._entidad_cols_display %}
          <th class="{% if not loop.first %}num{% endif %}">{{ col }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for fila in d._entidad_filas %}
        <tr>
          <td>{{ fila.Entidad }}</td>
          <td class="num">{{ "{:,.0f}".format(fila.Total) if fila.Total is not none else "—" }}</td>
          <td class="num">{{ "%.1f"|format(fila.Participacion) if fila.Participacion is not none else "—" }}%</td>
          <td class="num {% if fila.Var_anual is not none and fila.Var_anual >= 0 %}pos{% elif fila.Var_anual is not none %}neg{% endif %}">
            {{ "%+.1f"|format(fila.Var_anual) if fila.Var_anual is not none else "—" }}%
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>
{% endif %}

{% if d._productos %}
<div class="productos-card">
  <div class="productos-head">
    <h3>Productos con mayor incidencia · {{ d._productos.periodo }}</h3>
    <div class="source">{{ d._productos.fuente }}</div>
  </div>
  {% if d._productos.alza or d._productos.baja %}
  <div class="productos-grid">
    <div class="productos-col">
      <div class="productos-col-head productos-alza">Al alza</div>
      <table class="productos-tbl">
        <thead>
          <tr><th>Producto</th><th class="num">Var. mensual</th><th class="num">Incidencia</th></tr>
        </thead>
        <tbody>
          {% for p in d._productos.alza %}
          <tr>
            <td>{{ p.producto }}</td>
            <td class="num pos">{{ "%+.2f"|format(p.var_mensual) }}%</td>
            <td class="num pos">{{ "%+.3f"|format(p.incidencia) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="productos-col">
      <div class="productos-col-head productos-baja">A la baja</div>
      <table class="productos-tbl">
        <thead>
          <tr><th>Producto</th><th class="num">Var. mensual</th><th class="num">Incidencia</th></tr>
        </thead>
        <tbody>
          {% for p in d._productos.baja %}
          <tr>
            <td>{{ p.producto }}</td>
            <td class="num neg">{{ "%+.2f"|format(p.var_mensual) }}%</td>
            <td class="num neg">{{ "%+.3f"|format(p.incidencia) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  <div class="productos-nota">Incidencia en puntos porcentuales sobre la inflación general.</div>
  {% else %}
  <div class="pending-banner">⏳ {{ d._productos._placeholder or "Desglose por productos pendiente para este periodo." }}</div>
  {% endif %}
</div>
{% endif %}

{% if d._entidades_ciudades and (d._entidades_ciudades.entidades_alza or d._entidades_ciudades.ciudades_alza) %}
<div class="productos-card">
  <div class="productos-head">
    <h3>Variaciones por entidad y ciudad · {{ d._entidades_ciudades.periodo }}</h3>
    <div class="source">{{ d._entidades_ciudades.fuente }}</div>
  </div>
  <div class="productos-grid">
    <div class="productos-col">
      <div class="productos-col-head productos-alza">Entidades por arriba del promedio</div>
      <table class="productos-tbl">
        <thead><tr><th>Entidad</th><th class="num">Var. mensual</th></tr></thead>
        <tbody>
          {% for e in d._entidades_ciudades.entidades_alza %}
          <tr><td>{{ e.entidad }}</td><td class="num pos">{{ "%+.2f"|format(e.var_mensual) }}%</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="productos-col">
      <div class="productos-col-head productos-baja">Entidades por debajo del promedio</div>
      <table class="productos-tbl">
        <thead><tr><th>Entidad</th><th class="num">Var. mensual</th></tr></thead>
        <tbody>
          {% for e in d._entidades_ciudades.entidades_baja %}
          <tr><td>{{ e.entidad }}</td><td class="num">{{ "%+.2f"|format(e.var_mensual) }}%</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  <div class="productos-grid" style="margin-top:14px">
    <div class="productos-col">
      <div class="productos-col-head productos-alza">Ciudades por arriba del promedio</div>
      <table class="productos-tbl">
        <thead><tr><th>Ciudad</th><th class="num">Var. mensual</th></tr></thead>
        <tbody>
          {% for c in d._entidades_ciudades.ciudades_alza %}
          <tr><td>{{ c.ciudad }}</td><td class="num pos">{{ "%+.2f"|format(c.var_mensual) }}%</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="productos-col">
      <div class="productos-col-head productos-baja">Ciudades por debajo del promedio</div>
      <table class="productos-tbl">
        <thead><tr><th>Ciudad</th><th class="num">Var. mensual</th></tr></thead>
        <tbody>
          {% for c in d._entidades_ciudades.ciudades_baja %}
          <tr><td>{{ c.ciudad }}</td><td class="num">{{ "%+.2f"|format(c.var_mensual) }}%</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endif %}

{# ── Desglose sectorial IGAE ── #}
{% if d._desglose_sectorial %}
<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>Variación anual por sector de actividad</h3>
    <div class="source">{{ d._desglose_sectorial.periodo }} · BIE-INEGI</div>
  </div>
  <table class="analytics-tbl">
    <thead>
      <tr><th>Sector</th><th class="num">Var. anual (%)</th><th class="num">Lectura</th></tr>
    </thead>
    <tbody>
      {% for fila in d._desglose_sectorial.filas %}
      {% set v = fila.var_anual %}
      <tr class="{% if fila.sector.startswith('  ') %}{% else %}sector-total{% endif %}">
        <td class="{% if fila.sector.startswith('  ') %}sector-indent{% endif %}">{{ fila.sector.strip() }}</td>
        <td class="num {% if v > 0 %}pos{% elif v < 0 %}neg{% endif %}">{{ "%+.2f"|format(v) }}%</td>
        <td>{% if v > 3 %}Crecimiento sólido{% elif v > 0.5 %}Crecimiento moderado{% elif v > -0.5 %}Estancamiento{% elif v > -3 %}Caída moderada{% else %}Caída fuerte{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{# ── PEA flow ENOE trimestral ── #}
{% if d._pea_flow %}
<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>Distribución de la población</h3>
    <div class="source">{{ d._pea_flow.periodo }} · ENOE-INEGI</div>
  </div>
  <table class="analytics-tbl">
    <thead>
      <tr>
        <th>Concepto</th>
        <th class="num">Personas</th>
        <th class="num">Período anterior</th>
        <th class="num">Var. pp</th>
      </tr>
    </thead>
    <tbody>
      {% set conceptos_nivel2 = ["Ocupada", "Desocupada", "Disponible", "No disponible"] %}
      {% for fila in d._pea_flow.filas %}
      {% set es_indentado = fila.concepto in conceptos_nivel2 %}
      <tr class="{% if es_indentado %}pea-flow-indent{% else %}pea-flow-row{% endif %}">
        <td>{{ fila.concepto }}</td>
        <td class="num">{% if fila.abs_act is not none %}{{ "{:,.0f}".format(fila.abs_act) }}{% else %}—{% endif %}</td>
        <td class="num pea-abs">{% if fila.abs_prev is not none %}{{ "{:,.0f}".format(fila.abs_prev) }}{% else %}—{% endif %}</td>
        {% if fila.concepto == "Total" %}
          <td class="num" style="color:var(--texto-light)">—</td>
        {% elif fila.pct_act is not none and fila.pct_prev is not none %}
          {% set delta_pp = fila.pct_act - fila.pct_prev %}
          <td class="num {% if delta_pp > 0 %}pos{% elif delta_pp < 0 %}neg{% endif %}">{{ "%+.2f"|format(delta_pp) }}</td>
        {% else %}
          <td class="num">—</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<div class="chart-card">
  <h3>{{ "Serie completa" if not d.tabular else "Tabla de datos" }}</h3>
  <div class="table-wrap" style="box-shadow:none;border:none">
    <table>
      <caption class="sr-only">{{ "Tabla de datos de " if d.tabular else "Serie histórica completa de " }}{{ d.nombre }}</caption>
      {% if d.tabular %}
      <thead>
        <tr>
          {% for c in d.columnas %}<th scope="col" class="{% if d.filas[0] and d.filas[0][c] is number %}num{% endif %}">{{ d.columnas_display[loop.index0] if d.columnas_display else c }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for r in d.filas %}
        <tr>
          {% for c in d.columnas %}
            {% set v = r[c] %}
            {% if v is none %}<td>—</td>
            {% elif v is number %}
              {% if c in d.coloreable_cols %}
                <td class="num {% if v > 0 %}pos{% elif v < 0 %}neg{% endif %}">{{ "%+.1f"|format(v) if v != 0 else "0.0" }}</td>
              {% else %}
                <td class="num">{{ "{:,.1f}".format(v) }}</td>
              {% endif %}
            {% else %}<td>{{ v }}</td>
            {% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
      {% else %}
      <thead>
        <tr>
          <th scope="col">Periodo</th>
          {% for c in d.serie_cols %}<th scope="col" class="num">{{ c }}</th>{% endfor %}
          <th scope="col" class="num">MA12</th>
        </tr>
      </thead>
      <tbody>
        {% for p in d.periodos %}
        {% set i = loop.index0 %}
        <tr>
          <td>{{ p }}</td>
          {% for c in d.serie_cols %}
            {% set v = d.series[c][i] %}
            {% if v is none %}<td class="num">—</td>
            {% else %}<td class="num {% if v > 0 %}pos{% elif v < 0 %}neg{% endif %}">{{ "%.1f"|format(v) }}</td>
            {% endif %}
          {% endfor %}
          {% set m = d.ma12[i] %}
          <td class="num" style="color:var(--texto-light)">{% if m is none %}—{% else %}{{ "%.1f"|format(m) }}{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
      {% endif %}
    </table>
  </div>
  {% if d.tabular and d.id == "imai_estatal" %}
  <div class="productos-nota">Índice de volumen físico de la actividad industrial por entidad federativa, base 2018=100. Las columnas muestran el índice acumulado, no la variación porcentual.</div>
  {% endif %}
  <div class="detail-meta" style="margin-top:12px">
    Fuente: <a href="{{ d.fuente }}" target="_blank" rel="noopener">Boletín INEGI · saladeprensa →</a>
  </div>
</div>

{# ── Metodología acordeón ── #}
{% if d._metodologia %}
<details class="metodologia-details">
  <summary class="metodologia-summary">Nota metodológica · {{ d._metodologia.titulo }}</summary>
  <div class="metodologia-body">
    {% if d._metodologia.antecedentes %}
    <h4>Antecedentes y cobertura</h4>
    <p>{{ d._metodologia.antecedentes }}</p>
    {% endif %}
    {% if d._metodologia.periodicidad %}
    <h4>Periodicidad y publicación</h4>
    <p>{{ d._metodologia.periodicidad }}</p>
    {% endif %}
    {% if d._metodologia.cobertura %}
    <h4>Cobertura geográfica</h4>
    <p>{{ d._metodologia.cobertura }}</p>
    {% endif %}
    {% if d._metodologia.fuentes %}
    <h4>Fuentes de información</h4>
    <p>{{ d._metodologia.fuentes }}</p>
    {% endif %}
    {% if d._metodologia.muestreo %}
    <h4>Diseño muestral</h4>
    <p>{{ d._metodologia.muestreo }}</p>
    {% endif %}
    {% if d._metodologia.ajuste %}
    <h4>Ajuste estacional</h4>
    <p>{{ d._metodologia.ajuste }}</p>
    {% endif %}
    {% if d._metodologia.links %}
    <div class="metodologia-links">
      {% for link in d._metodologia.links %}
      <a class="metodologia-link" href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }} →</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</details>
{% endif %}

<script id="page-data" type="application/json">{{ page_data_json | safe }}</script>
{% endblock %}
