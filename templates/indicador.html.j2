      <div class="valor">{% if d.drilldown.coincidente.valor is not none %}{{ "%+.2f"|format(d.drilldown.coincidente.valor) }} pts{% else %}—{% endif %}</div>
    </div>
    <div class="drilldown-stat-card {% if d.drilldown.adelantado.valor is not none and d.drilldown.adelantado.valor > 0 %}saldo-pos{% elif d.drilldown.adelantado.valor is not none and d.drilldown.adelantado.valor < 0 %}saldo-neg{% endif %}">
      <div class="label">Adelantado · {{ d.drilldown.adelantado.periodo }}</div>
      <div class="valor">{% if d.drilldown.adelantado.valor is not none %}{{ "%+.2f"|format(d.drilldown.adelantado.valor) }} pts{% else %}—{% endif %}</div>
    </div>
  </div>
  <div class="productos-nota">El Coincidente se publica con 2 meses de rezago; el Adelantado con 1. La tendencia de largo plazo se representa en 100 puntos. Diferencias negativas indican desaceleración respecto al mes anterior.</div>
</div>
{% endif %}

{% if d.drilldown and d.drilldown.tipo == "pib_anual" %}
<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>PIB por actividad económica · variación trimestral y anual</h3>
    <div class="source">{{ d.drilldown.periodo }} · cifras desestacionalizadas · BIE-INEGI</div>
  </div>
  <div style="overflow-x:auto">
  <table class="analytics-tbl">
    <thead>
      <tr>
        <th>Actividad</th>
        <th class="num">Var. trimestral</th>
        <th class="num">Var. anual</th>
      </tr>
    </thead>
    <tbody>
      {% for fila in d.drilldown.filas %}
      <tr class="{% if not fila.indent %}sector-total{% endif %}">
        <td {% if fila.indent %}class="sector-indent" style="padding-left:20px"{% endif %}>{{ fila.actividad.strip() }}</td>
        <td class="num {% if fila.var_trimestral is not none and fila.var_trimestral > 0 %}pos{% elif fila.var_trimestral is not none and fila.var_trimestral < 0 %}neg{% endif %}">
          {% if fila.var_trimestral is not none %}{{ "%+.2f"|format(fila.var_trimestral) }}%{% else %}—{% endif %}
        </td>
        <td class="num {% if fila.var_anual is not none and fila.var_anual > 0 %}pos{% elif fila.var_anual is not none and fila.var_anual < 0 %}neg{% endif %}">
          {% if fila.var_anual is not none %}{{ "%+.2f"|format(fila.var_anual) }}%{% else %}—{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <div class="productos-nota">Cifras elaboradas mediante métodos econométricos. Fuente: INEGI · Sistema de Cuentas Nacionales de México.</div>
</div>
{% endif %}

{% if d.drilldown and d.drilldown.tipo in ("autos_ligeros", "autos_pesados") %}
<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>Variación anual por tipo · últimos 24 meses</h3>
    <div class="source">Variación % anual · {{ d.drilldown.periodos[0] if d.drilldown.periodos else "" }} a {{ d.drilldown.periodos[-1] if d.drilldown.periodos else "" }} · INEGI-AMIA</div>
  </div>
  <div class="drilldown-saldo-cards">
    {% for nombre, val in d.drilldown.ultimo.items() %}
    <div class="drilldown-stat-card {% if val is not none and val > 0 %}saldo-pos{% elif val is not none and val < 0 %}saldo-neg{% endif %}">
      <div class="label">{{ nombre.replace("_", " ") }}</div>
      <div class="valor">{% if val is not none %}{{ "%+.1f"|format(val) }}%{% else %}—{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  <div class="drilldown-chart-wrap">
    <canvas id="chart-autos-series"></canvas>
  </div>
</div>
{% endif %}

{% if d.drilldown and d.drilldown.tipo == "enec" %}
