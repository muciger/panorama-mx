{% extends "base.html.j2" %}
{% block content %}

<nav class="breadcrumb-nav" aria-label="Ruta">
  <a class="breadcrumb" href="{{ asset_prefix }}index.html">Vista general</a>
  <span class="breadcrumb-sep">›</span>
  <span class="breadcrumb-cat">{{ d.categoria }}</span>
  <span class="breadcrumb-sep">›</span>
  <span class="breadcrumb-current">{{ d.nombre }}</span>
</nav>

<div class="detail-header">
  <div>
    <h1 class="detail-title">{{ d.nombre }}</h1>
    <div class="detail-meta">
      Categoría: <strong>{{ d.categoria }}</strong> · Unidad: <strong>{{ d.unidad }}</strong>
      {% if not d.tabular and d.periodos %} · Último periodo: <strong>{{ d.periodos[-1] }}</strong>{% endif %}
      {% if d.z_score and d.z_score.categoria != 'normal' %}
      <span class="outlier-badge outlier-{{ d.z_score.categoria }}">
        {% if d.z_score.categoria == 'extremo' %}⚠ Movimiento extremo{% else %}⚡ Movimiento atípico{% endif %}
        · z = {{ "%+.2f"|format(d.z_score.z) }}σ
      </span>
      {% endif %}
    </div>
  </div>
  <div class="detail-actions">
    <a class="indic-btn" href="{{ asset_prefix }}data/{{ d.id }}.csv" download>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Descargar CSV</span>
    </a>
    {% if d.fuente %}
    <a class="indic-btn" href="{{ d.fuente }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 4h6v6M10 14L20 4M19 13v6a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1h6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Boletín INEGI</span>
    </a>
    {% endif %}
  </div>
</div>

<div class="detail-grid">
  <div class="chart-card">
    <div class="chart-card-head">
      <h3>{% if d.id == "empleo_imss" %}Variación interanual — total nacional{% elif d._chart_titulo %}{{ d._chart_titulo }}{% elif d.tabular %}{% if d._chart_tipo in ("bar_horizontal", "bar_grouped_horizontal") %}{{ d._label_tabla }}{% else %}Detalle tabular{% endif %}{% elif d._chart_tipo == "bar_vertical" %}Variación real anual{% elif d._chart_tipo == "bar_grouped" %}Variación real{% else %}Serie histórica con promedio móvil{% endif %}</h3>
      {% if not d.tabular and d._chart_tipo not in ("bar_vertical", "bar_grouped") %}
      <div class="range-pills" id="range-pills" role="tablist" aria-label="Rango temporal del chart">
        <button class="range-pill" data-range="12" type="button">1A</button>
        <button class="range-pill" data-range="36" type="button">3A</button>
        <button class="range-pill active" data-range="60" type="button">5A</button>
        <button class="range-pill" data-range="120" type="button">10A</button>
        <button class="range-pill" data-range="0" type="button">Todo</button>
      </div>
      {% endif %}
    </div>
    <div class="chart-container">
      {% if d.id == "empleo_imss" %}
      <canvas id="imss-main-chart"></canvas>
      {% elif d.tabular and d._chart_tipo not in ("bar_horizontal", "bar_grouped_horizontal") %}
      <div style="height:300px;display:flex;align-items:center;justify-content:center;flex-direction:column;color:var(--texto-light);font-size:13px">
        <strong style="color:var(--texto);font-size:15px;margin-bottom:8px">Vista tabular</strong>
        Este indicador no tiene serie temporal. Ver tabla abajo.
      </div>
      {% else %}
      <canvas id="detail-chart"></canvas>
      {% endif %}
    </div>
    {% if d.id == "empleo_imss" %}
    <div class="legend">
      <span><span class="swatch" style="background:#4B7FD4"></span>Crecimiento</span>
      <span><span class="swatch" style="background:#B5262C"></span>Pérdida</span>
    </div>
    {% elif not d.tabular and d._chart_tipo not in ("bar_vertical", "bar_grouped") %}
    <div class="legend">
      <span><span class="swatch" style="background:#0891B2"></span>Serie principal</span>
      <span><span class="swatch" style="background:#7C3AED"></span>Serie secundaria</span>
      <span><span class="dashed" style="border-top-color:#18181B"></span>Promedio móvil 12M</span>
    </div>
    {% if d.id == "confianza_consumidor" %}
    <div class="productos-nota" style="margin-top:8px">La serie muestra la diferencia en puntos respecto al periodo anterior (var. mensual y anual), no el nivel absoluto del ICC. El umbral neutral del índice de nivel es 50 pts.</div>
    {% endif %}
    {% endif %}
  </div>

  <div class="stats-col">
    <div class="stat-card">
      <div class="label">Último valor</div>
      <div class="valor">{{ d.stat_valor }}</div>
      <div class="nota">{{ d.stat_valor_nota }}</div>
    </div>
    <div class="stat-card">
      <div class="label">{{ d.stat_delta_label }}</div>
      <div class="valor">{{ d.stat_delta }}</div>
      <div class="nota">{{ d.stat_delta_nota }}</div>
    </div>
    <div class="stat-card" id="proxima-pub-card" data-next-date="{{ d.proximaPub.fecha_iso if d.proximaPub.fecha_iso else '' }}">
      <div class="label">Próxima publicación</div>
      <div class="valor-fecha" id="proxima-pub-valor">{{ d.proximaPub.fecha }}</div>
      <div class="nota" id="proxima-pub-nota">{{ d.proximaPub.tipo }}</div>
    </div>
    {% if d.id == "empleo_imss" %}
    <div class="stat-card">
      <div class="label">Permanentes</div>
      <div class="valor">{{ d._perm_pct }}%</div>
      <div class="nota">del total de puestos</div>
    </div>
    <div class="stat-card">
      <div class="label">Mujeres</div>
      <div class="valor">{{ d._muj_pct }}%</div>
      <div class="nota">del total de puestos</div>
    </div>
    {% endif %}
  </div>
</div>

{% if d.id == "empleo_imss" and d._sector_yoy %}
<section class="imss-sector-section">
  <header class="card-head">
    <h3>Variación interanual por sector económico</h3>
    <div class="source">Variación % vs mismo mes año anterior. Trabajadores registrados IMSS. {{ d._nac_yoy_periodos[0] if d._nac_yoy_periodos else "" }} – {{ d.periodo_referencia }}.</div>
  </header>
  <div class="imss-sector-grid" id="imss-sector-grid">
    {% for sector_name, sector_data in d._sector_yoy.items() %}
    {% set ult_val = sector_data.var_anual[-1] if sector_data.var_anual else none %}
    <div class="imss-sector-card">
      <div class="imss-sector-card-head">
        <span class="imss-sector-nombre">{{ sector_name }}</span>
        {% if ult_val is not none and ult_val < 0 %}
        <span class="imss-badge-neg">negativo</span>
        {% endif %}
      </div>
      <div class="imss-sector-val {% if ult_val is not none and ult_val >= 0 %}pos{% elif ult_val is not none %}neg{% endif %}">
        {{ "%+.1f"|format(ult_val) if ult_val is not none else "—" }}% {{ d.periodo_referencia }}
      </div>
      <div class="imss-sector-chart-wrap">
        <canvas class="imss-sector-chart"
                data-periodos="{{ sector_data.periodos | tojson }}"
                data-valores="{{ sector_data.var_anual | tojson }}"></canvas>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── Recuadros resumen INPC (cabecera del comunicado) ── #}
{% if d._recuadros_inpc %}
<div class="inpc-recuadros">
  <div class="inpc-recuadros-periodo">{{ d._recuadros_inpc.periodo }}</div>
  <div class="inpc-recuadros-grid">
    {% for c in d._recuadros_inpc.componentes %}
    <div class="inpc-recuadro">
      <div class="inpc-recuadro-titulo">{{ c.nombre }}</div>
      <div class="inpc-recuadro-periodo-label">{{ d._recuadros_inpc.periodo }}</div>
      <div class="inpc-recuadro-cols">
        <div class="inpc-recuadro-col">
          <div class="inpc-recuadro-sublabel">{{ d._recuadros_inpc.etiqueta_variacion or "mensual" }}</div>
          <div class="inpc-recuadro-val {% if c.var_mensual and c.var_mensual > 0 %}pos{% elif c.var_mensual and c.var_mensual < 0 %}neg{% endif %}">
            {% if c.var_mensual and c.var_mensual > 0 %}▲{% elif c.var_mensual and c.var_mensual < 0 %}▼{% endif %}
            {% if c.var_mensual is not none %}{{ "%.2f"|format(c.var_mensual) }} %{% else %}—{% endif %}
          </div>
        </div>
        <div class="inpc-recuadro-col">
          <div class="inpc-recuadro-sublabel">anual</div>
          <div class="inpc-recuadro-val {% if c.var_anual > 0 %}pos{% elif c.var_anual < 0 %}neg{% endif %}">
            {% if c.var_anual > 0 %}▲{% elif c.var_anual < 0 %}▼{% endif %}
            {{ "%.2f"|format(c.var_anual) }} %
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{# ── Cuadro 1: Variación e incidencia INPC y componentes ── #}
{% if d._cuadro1 %}
<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>Variación e incidencia por componente</h3>
    <div class="source">{{ d._cuadro1.periodo }} · {{ d._cuadro1.fuente }}</div>
  </div>
  <div style="overflow-x:auto">
  {% set c1_tiene_incidencia = d._cuadro1.filas and d._cuadro1.filas[0].inc_mensual is not none %}
  <table class="analytics-tbl inpc-cuadro1-tbl">
    <thead>
      <tr>
        <th>Concepto</th>
        <th class="num">Var. {{ d._cuadro1.etiqueta_variacion or "mensual" }}</th>
        <th class="num">Var. anual</th>
        {% if c1_tiene_incidencia %}
        <th class="num">Inc. {{ d._cuadro1.etiqueta_variacion or "mensual" }}</th>
        <th class="num">Inc. anual</th>
        {% endif %}
      </tr>
    </thead>
    <tbody>
      {% for fila in d._cuadro1.filas %}
      <tr class="inpc-c1-nivel{{ fila.nivel }}">
        <td class="{% if fila.nivel > 0 %}sector-indent{% endif %}" style="padding-left:{{ fila.nivel * 16 }}px">{{ fila.concepto }}</td>
        <td class="num {% if fila.var_mensual is not none and fila.var_mensual > 0 %}pos{% elif fila.var_mensual is not none and fila.var_mensual < 0 %}neg{% endif %}">{% if fila.var_mensual is not none %}{{ "%+.2f"|format(fila.var_mensual) }}%{% else %}—{% endif %}</td>
        <td class="num {% if fila.var_anual is not none and fila.var_anual > 0 %}pos{% elif fila.var_anual is not none and fila.var_anual < 0 %}neg{% endif %}">{% if fila.var_anual is not none %}{{ "%+.2f"|format(fila.var_anual) }}%{% else %}—{% endif %}</td>
        {% if c1_tiene_incidencia %}
        <td class="num {% if fila.inc_mensual is not none and fila.inc_mensual > 0 %}pos{% elif fila.inc_mensual is not none and fila.inc_mensual < 0 %}neg{% endif %}">{% if fila.inc_mensual is not none %}{{ "%+.3f"|format(fila.inc_mensual) }}{% else %}—{% endif %}</td>
        <td class="num {% if fila.inc_anual is not none and fila.inc_anual > 0 %}pos{% elif fila.inc_anual is not none and fila.inc_anual < 0 %}neg{% endif %}">{% if fila.inc_anual is not none %}{{ "%+.3f"|format(fila.inc_anual) }}{% else %}—{% endif %}</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% if c1_tiene_incidencia %}
  <div class="productos-nota">Incidencia en puntos porcentuales sobre el índice general.</div>
  {% endif %}
</div>
{% endif %}

<div class="interp">
  <div class="interp-head">
    <h3>Interpretación</h3>
    <div class="source">{{ d.interp_source }}</div>
  </div>
  {% if d.interp.tipo == "auto" %}
    {% if d.interp.mensaje %}<div class="interp-block"><p>{{ d.interp.mensaje }}</p></div>{% endif %}
  {% elif d.interp.tipo in ("demo", "sonnet") %}
    {% if d.interp.direccion %}<div class="interp-block"><div class="bloque-label">Dirección y magnitud</div><p>{{ d.interp.direccion }}</p></div>{% endif %}
    {% if d.interp.comparacion %}<div class="interp-block"><div class="bloque-label">Comparación histórica</div><p>{{ d.interp.comparacion }}</p></div>{% endif %}
    {% if d.interp.macro %}<div class="interp-block"><div class="bloque-label">Lectura macro</div><p>{{ d.interp.macro }}</p></div>{% endif %}
    {% if d.interp.banderas %}<div class="interp-block"><div class="bloque-label">Banderas y riesgos</div><p>{{ d.interp.banderas }}</p></div>{% endif %}
  {% else %}
    <div class="pending-banner">
      <div class="pending-banner-title">⏳ Interpretación pendiente</div>
      {% if d.periodos and d.series %}
        {% set serie_principal = d.series[d.serie_cols[0]] if d.serie_cols else [] %}
        {% if serie_principal and serie_principal|length >= 3 %}
        <div class="pending-tendencia">
          Últimos 3 periodos:
          {% for v in serie_principal[-3:] %}
            <span class="{% if v and v > 0 %}pos{% elif v and v < 0 %}neg{% endif %}">{{ "%+.1f"|format(v) if v is not none else "—" }}{{ d.unidad }}</span>{% if not loop.last %}, {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      {% endif %}
      <div class="pending-next">Próxima publicación: {{ d.proximaPub.fecha }}
        {% if d.fuente %} · <a href="{{ d.fuente }}" target="_blank" rel="noopener">Ver boletín INEGI</a>{% endif %}
      </div>
    </div>
  {% endif %}
</div>

{% if d.stats %}
<div class="analytics-grid" id="analytics-grid">
  <div class="analytics-card">
    <div class="analytics-card-head">
      <h4>Estadísticos descriptivos · últimos {{ d.stats.count }} obs</h4>
      <button class="adv-toggle-btn" id="adv-toggle-btn" type="button" aria-expanded="false">Ver avanzados</button>
    </div>
    <table class="analytics-tbl">
      <caption class="sr-only">Estadísticos descriptivos de {{ d.nombre }}, últimos {{ d.stats.count }} periodos</caption>
      <thead><tr><th scope="col">Métrica</th><th scope="col" class="num">Valor</th><th scope="col">Métrica</th><th scope="col" class="num">Valor</th></tr></thead>
      <tbody>
      <tr><td>Media</td><td class="num">{{ "%.2f"|format(d.stats.mean) }}{{ d.unidad }}</td>
          <td>Mediana</td><td class="num">{{ "%.2f"|format(d.stats.p50) }}{{ d.unidad }}</td></tr>
      <tr><td>Mínimo</td><td class="num">{{ "%.2f"|format(d.stats.min) }}{{ d.unidad }}</td>
          <td>Máximo</td><td class="num">{{ "%.2f"|format(d.stats.max) }}{{ d.unidad }}</td></tr>
      <tr class="stat-adv"><td>Desv. estándar</td><td class="num">{{ "%.2f"|format(d.stats.std) }}{{ d.unidad }}</td>
          <td>p25 / p75</td><td class="num">{{ "%.1f"|format(d.stats.p25) }} / {{ "%.1f"|format(d.stats.p75) }}{{ d.unidad }}</td></tr>
      </tbody>
    </table>
  </div>
  {% if d.lags %}
  <div class="analytics-card">
    <h4>Comparativos lag</h4>
    <table class="analytics-tbl">
      <caption class="sr-only">Comparativos históricos de {{ d.nombre }} respecto al valor actual</caption>
      <thead><tr><th scope="col">Periodo</th><th scope="col" class="num">Hace</th><th scope="col" class="num">Δ vs hoy</th></tr></thead>
      <tbody>
      {% for lag in ['1m','3m','6m','12m','24m'] %}{% if d.lags[lag] %}
        <tr><td>{{ lag }} ({{ d.lags[lag].periodo }})</td>
            <td class="num">{{ "%.2f"|format(d.lags[lag].valor) }}{{ d.unidad }}</td>
            <td class="num {% if d.lags[lag].delta > 0 %}pos{% elif d.lags[lag].delta < 0 %}neg{% endif %}">{{ "%+.2f"|format(d.lags[lag].delta) }}{{ d.unidad }}</td></tr>
      {% endif %}{% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% if d.extremos %}
  <div class="analytics-card">
    <h4>Récords históricos · {{ d.periodos[0] if d.periodos else "" }} a {{ d.periodos[-1] if d.periodos else "" }}</h4>
    <div class="record-row">
      <div class="record-card record-mejor">
        <div class="record-label">{% if d.extremos.mejor.valor >= 0 %}Récord positivo{% else %}Mejor valor{% endif %}</div>
        <div class="record-valor">{{ "%+.2f"|format(d.extremos.mejor.valor) }}{{ d.unidad }}</div>
        <div class="record-periodo">{{ d.extremos.mejor.periodo }}</div>
      </div>
      <div class="record-card record-peor">
        <div class="record-label">{% if d.extremos.peor.valor <= 0 %}Récord negativo{% else %}Peor valor{% endif %}</div>
        <div class="record-valor">{{ "%+.2f"|format(d.extremos.peor.valor) }}{{ d.unidad }}</div>
        <div class="record-periodo">{{ d.extremos.peor.periodo }}</div>
      </div>
      {% if d.percentil %}
      <div class="record-card record-percentil stat-adv">
        <div class="record-label">Posición actual</div>
        <div class="record-valor">p{{ d.percentil.p }}</div>
        <div class="record-periodo">sobre {{ d.percentil.muestra }} obs</div>
      </div>
      {% endif %}
      {% if d.z_score %}
      <div class="record-card record-zscore record-z-{{ d.z_score.categoria }} stat-adv">
        <div class="record-label">Z-score</div>
        <div class="record-valor">{{ "%+.2f"|format(d.z_score.z) }}σ</div>
        <div class="record-periodo">{{ d.z_score.categoria }}</div>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}
</div>
{% endif %}

{% if d.drilldown and d.drilldown.tipo == "balanza_comercial" %}
<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>Saldo de balanza comercial · MDD desestacionalizado</h3>
    <div class="source">Últimos 60 meses · BIE-INEGI</div>
  </div>
  <div class="drilldown-saldo-cards">
    {% for nombre, val in d.drilldown.saldos_ultimo.items() %}
    <div class="drilldown-stat-card {% if val and val > 0 %}saldo-pos{% elif val and val < 0 %}saldo-neg{% endif %}">
      <div class="label">Saldo {{ nombre }}</div>
      <div class="valor">{% if val %}{{ "{:+,.0f}".format(val) }} MDD{% else %}—{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  <div class="drilldown-chart-wrap">
    <canvas id="chart-balanza-saldos"></canvas>
  </div>
</div>

<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>Composición de exportaciones · variación anual desestacionalizada</h3>
    <div class="source">Último mes vs serie histórica · BIE-INEGI</div>
  </div>
  <table class="analytics-tbl">
    <thead><tr><th>Categoría</th><th class="num">Var. anual</th><th class="num">Aporte cualitativo</th></tr></thead>
    <tbody>
      {% for nombre, val in d.drilldown.export_ultimo.items() %}
      <tr>
        <td>{{ nombre }}</td>
        <td class="num {% if val and val > 0 %}pos{% elif val and val < 0 %}neg{% endif %}">{% if val is not none %}{{ "%+.2f"|format(val) }}%{% else %}—{% endif %}</td>
        <td>{% if val is not none %}{% if val > 20 %}Alto crecimiento{% elif val > 5 %}Crecimiento moderado{% elif val > 0 %}Crecimiento ligero{% elif val > -5 %}Caída ligera{% else %}Caída sustancial{% endif %}{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="drilldown-chart-wrap">
    <canvas id="chart-balanza-exports"></canvas>
  </div>
</div>

<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>Composición de importaciones por tipo de bien · variación anual</h3>
    <div class="source">Lectura de demanda interna · BIE-INEGI</div>
  </div>
  <table class="analytics-tbl">
    <thead><tr><th>Tipo de bien</th><th class="num">Var. anual</th><th>Lectura</th></tr></thead>
    <tbody>
      <tr>
        <td>Bienes de consumo</td>
        <td class="num {% if d.drilldown.import_ultimo.Consumo and d.drilldown.import_ultimo.Consumo > 0 %}pos{% elif d.drilldown.import_ultimo.Consumo and d.drilldown.import_ultimo.Consumo < 0 %}neg{% endif %}">{% if d.drilldown.import_ultimo.Consumo is not none %}{{ "%+.2f"|format(d.drilldown.import_ultimo.Consumo) }}%{% else %}—{% endif %}</td>
        <td>Termómetro consumo final hogares</td>
      </tr>
      <tr>
        <td>Bienes intermedios</td>
        <td class="num {% if d.drilldown.import_ultimo.Intermedios and d.drilldown.import_ultimo.Intermedios > 0 %}pos{% elif d.drilldown.import_ultimo.Intermedios and d.drilldown.import_ultimo.Intermedios < 0 %}neg{% endif %}">{% if d.drilldown.import_ultimo.Intermedios is not none %}{{ "%+.2f"|format(d.drilldown.import_ultimo.Intermedios) }}%{% else %}—{% endif %}</td>
        <td>Insumos para producción manufacturera</td>
      </tr>
      <tr>
        <td>Bienes de capital</td>
        <td class="num {% if d.drilldown.import_ultimo.Capital and d.drilldown.import_ultimo.Capital > 0 %}pos{% elif d.drilldown.import_ultimo.Capital and d.drilldown.import_ultimo.Capital < 0 %}neg{% endif %}">{% if d.drilldown.import_ultimo.Capital is not none %}{{ "%+.2f"|format(d.drilldown.import_ultimo.Capital) }}%{% else %}—{% endif %}</td>
        <td>Inversión productiva (maquinaria, equipo)</td>
      </tr>
    </tbody>
  </table>
  <div class="drilldown-chart-wrap">
    <canvas id="chart-balanza-imports"></canvas>
  </div>
</div>
{% endif %}

{% if d.drilldown and d.drilldown.tipo == "pib_trimestral" %}
<div class="drilldown-card">
  <div class="drilldown-head">
    <h3>PIB por gran actividad económica · variación anual desestacionalizada</h3>
