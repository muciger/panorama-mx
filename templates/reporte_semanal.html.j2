<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reporte semanal · Panorama MX</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<style>
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:'Inter','Helvetica Neue',Arial,sans-serif;background:#F4F4F5;color:#18181B;line-height:1.5;-webkit-font-smoothing:antialiased;font-size:14px}
a{color:inherit;text-decoration:none}

.page{max-width:880px;margin:0 auto;padding:32px 28px 56px}

/* Nav */
.rpt-nav{display:flex;gap:10px;margin-bottom:32px;align-items:center}
.rpt-nav-back{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#7C3AED;font-weight:500}
.rpt-nav-back:hover{text-decoration:underline}
.rpt-nav-print{margin-left:auto;display:inline-flex;align-items:center;gap:6px;padding:7px 16px;background:#18181B;color:#fff;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;border:none;font-family:inherit;letter-spacing:0.01em}
.rpt-nav-print:hover{background:#27272A}

/* Header */
.rpt-header{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:20px;border-bottom:2px solid #18181B;margin-bottom:28px}
.rpt-brand-block{display:flex;align-items:center;gap:14px}
.pmx-mark{width:40px;height:40px;background:#18181B;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pmx-mark-text{font-size:13px;font-weight:700;color:#fff;letter-spacing:-0.02em;line-height:1}
.pmx-mark-text span{color:#7C3AED}
.rpt-brand-name{font-size:14px;font-weight:700;color:#18181B;letter-spacing:-0.01em}
.rpt-brand-sub{font-size:10px;color:#71717A;text-transform:uppercase;letter-spacing:0.08em;margin-top:2px}
.rpt-meta{text-align:right}
.rpt-title{font-size:22px;font-weight:700;color:#18181B;letter-spacing:-0.02em;line-height:1.2}
.rpt-semana{font-size:11px;color:#71717A;margin-top:4px;text-transform:uppercase;letter-spacing:0.05em}

/* Estado agregado */
.estado-block{display:flex;align-items:center;gap:14px;padding:14px 18px;border-radius:10px;margin-bottom:24px;border:1px solid}
.estado-rojo{background:#FEF2F2;border-color:#FECACA}
.estado-amarillo{background:#FFFBEB;border-color:#FDE68A}
.estado-verde{background:#F0FDF4;border-color:#BBF7D0}
.estado-neutro{background:#F9FAFB;border-color:#E4E4E7}
.estado-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.estado-rojo .estado-dot{background:#DC2626}
.estado-amarillo .estado-dot{background:#D97706}
.estado-verde .estado-dot{background:#16A34A}
.estado-neutro .estado-dot{background:#A1A1AA}
.estado-texto{font-size:13px;font-weight:700;color:#18181B}
.estado-sep{color:#D1D5DB;margin:0 4px}
.estado-detalle{font-size:12px;color:#71717A}

/* Section labels */
.section-label{font-size:10px;font-weight:700;color:#71717A;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:16px}

/* Síntesis ejecutiva */
.resumen-box{background:#18181B;border-radius:12px;padding:22px 24px;margin-bottom:32px}
.resumen-header{font-size:10px;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px}
.resumen-grid{display:flex;flex-direction:column;gap:12px}
.resumen-section{display:flex;gap:14px;align-items:flex-start}
.resumen-section-left{display:flex;align-items:center;gap:8px;min-width:140px;flex-shrink:0}
.resumen-tema-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:1px}
.resumen-tema-name{font-size:12px;font-weight:600;color:rgba(255,255,255,0.9);white-space:nowrap}
.resumen-dir{font-size:14px;margin-left:2px}
.resumen-dir-up{color:#4ADE80}
.resumen-dir-down{color:#F87171}
.resumen-dir-flat{color:rgba(255,255,255,0.4)}
.resumen-bullets{display:flex;flex-direction:column;gap:3px}
.resumen-bullet-item{font-size:11.5px;color:rgba(255,255,255,0.65);line-height:1.4}
.resumen-divider{height:1px;background:rgba(255,255,255,0.08);margin:4px 0}

/* Leyenda semáforo */
.legend-row{display:flex;gap:16px;margin-bottom:24px;flex-wrap:wrap}
.legend-item{display:flex;align-items:center;gap:6px;font-size:11px;color:#52525B}
.legend-dot{width:8px;height:8px;border-radius:50%}

/* Cards de indicadores */
.indic-list{display:flex;flex-direction:column;gap:10px;margin-bottom:36px}
.indic-row{background:#fff;border:1px solid #E4E4E7;border-radius:10px;padding:20px 22px;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:flex-start;min-height:110px}
.indic-row.indic-priority{border-top:3px solid #18181B}
.indic-row.indic-priority.alerta-rojo{border-top-color:#DC2626}
.indic-row.indic-priority.alerta-amarillo{border-top-color:#D97706}
.indic-row.indic-priority.alerta-verde{border-top-color:#16A34A}
.semaforo{width:10px;height:10px;flex-shrink:0;margin-top:5px}
/* Forma distinta por estado para daltonismo */
.sem-verde{background:#16A34A;border-radius:50%}
.sem-amarillo{background:#D97706;border-radius:2px;transform:rotate(45deg)}
.sem-rojo{background:#DC2626;clip-path:polygon(50% 0%,0% 100%,100% 100%)}
.sem-neutro{background:#A1A1AA;border-radius:2px}
.indic-body{min-width:0}
.indic-nombre{font-size:13.5px;font-weight:600;color:#18181B;margin-bottom:4px}
.indic-meta{font-size:10px;color:#A1A1AA;display:flex;gap:10px;flex-wrap:wrap;margin-bottom:6px}
.indic-meta-pub{color:#71717A}
.indic-context{font-size:12.5px;color:#3F3F46;line-height:1.55}
.indic-vals{text-align:right;flex-shrink:0;min-width:140px}
.indic-valor{font-size:26px;font-weight:700;letter-spacing:-0.03em;color:#18181B;line-height:0.95}
.indic-delta{font-size:11px;font-weight:600;margin-top:6px}
.delta-pos{color:#16A34A}
.delta-neg{color:#DC2626}
.delta-neu{color:#71717A}
.indic-unidad{font-size:10px;color:#71717A;font-weight:400;margin-top:3px}
.indic-spark{margin-top:10px;line-height:0}
.indic-spark svg{opacity:0.88}

/* Sin publicaciones */
.empty-state{background:#FAFAFA;border:1px solid #E4E4E7;border-radius:10px;padding:24px;text-align:center;color:#71717A;font-size:13px;margin-bottom:32px}

/* Próximas publicaciones */
.proximas-grupos{display:flex;flex-direction:column;gap:20px;margin-bottom:36px}
.prox-grupo-label{font-size:10px;font-weight:700;color:#7C3AED;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px}
.proximas-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:8px}
.prox-card{background:#fff;border:1px solid #E4E4E7;border-radius:8px;padding:12px 14px}
.prox-fecha{font-size:10px;color:#7C3AED;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px}
.prox-nombre{font-size:12px;font-weight:600;color:#18181B;line-height:1.35}
.prox-freq{font-size:10px;color:#71717A;margin-top:2px}

/* Footer */
.rpt-footer{border-top:1px solid #E4E4E7;margin-top:40px;padding-top:20px;font-size:10px;color:#71717A;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}

/* Mobile */
@media(max-width:640px){
  .page{padding:20px 16px 40px}
  .indic-row{grid-template-columns:auto 1fr;gap:12px}
  .indic-vals{grid-column:2;text-align:left;margin-top:8px}
  .indic-valor{font-size:22px}
  .rpt-header{flex-direction:column;gap:12px}
  .rpt-meta{text-align:left}
  .resumen-section{flex-direction:column;gap:4px}
  .resumen-section-left{min-width:unset}
}

/* Print */
@media print{
  body{background:#fff;font-size:12px}
  .page{padding:16px 20px;max-width:none}
  .rpt-nav{display:none}
  .indic-row{break-inside:avoid;border-radius:0;margin-bottom:6px}
  .prox-card{break-inside:avoid}
  .resumen-box{background:#18181B !important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .estado-block{break-inside:avoid}
  a[href]::after{content:none}
}
</style>
</head>
<body>
<div class="page">

  <nav class="rpt-nav">
    <a class="rpt-nav-back" href="{{ asset_prefix }}index.html">← Volver al tablero</a>
    <button class="rpt-nav-print" onclick="window.print()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
      Imprimir / PDF
    </button>
  </nav>

  <header class="rpt-header">
    <div class="rpt-brand-block">
      <div class="pmx-mark"><div class="pmx-mark-text">P<span>MX</span></div></div>
      <div>
        <div class="rpt-brand-name">Panorama MX</div>
        <div class="rpt-brand-sub">INEGI · BIE · Datos oficiales</div>
      </div>
    </div>
    <div class="rpt-meta">
      <div class="rpt-title">Reporte semanal</div>
      <div class="rpt-semana">{{ semana_label }}</div>
    </div>
  </header>

  {# Estado agregado #}
  <div class="estado-block estado-{{ estado_agregado.alerta }}">
    <div class="estado-dot"></div>
    <span class="estado-texto">{{ estado_agregado.texto }}</span>
    <span class="estado-sep">·</span>
    <span class="estado-detalle">{{ estado_agregado.detalle }}</span>
  </div>

  {# Síntesis ejecutiva #}
  {% if resumen_sections %}
  <div class="resumen-box">
    <div class="resumen-header">Síntesis ejecutiva</div>
    <div class="resumen-grid">
      {% for sec in resumen_sections %}
      {% if not loop.first %}<div class="resumen-divider"></div>{% endif %}
      <div class="resumen-section">
        <div class="resumen-section-left">
          <div class="resumen-tema-dot sem-{{ sec.alerta }}"></div>
          <span class="resumen-tema-name">{{ sec.tema }}</span>
          <span class="resumen-dir {% if sec.dir == '↑' %}resumen-dir-up{% elif sec.dir == '↓' %}resumen-dir-down{% else %}resumen-dir-flat{% endif %}">{{ sec.dir }}</span>
        </div>
        <div class="resumen-bullets">
          {% for b in sec.bullets %}
          <div class="resumen-bullet-item">{{ b.texto }}</div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="section-label">Publicaciones recientes · {{ n_publicados }} indicador{{ 'es' if n_publicados != 1 else '' }}</div>

  {% if not publicados %}
  <div class="empty-state">No se identificaron publicaciones de INEGI en los últimos 14 días.</div>
  {% else %}
  <div class="legend-row">
    <div class="legend-item"><div class="legend-dot sem-verde" role="img" aria-label="círculo verde"></div>En parámetro</div>
    <div class="legend-item"><div class="legend-dot sem-amarillo" role="img" aria-label="diamante amarillo"></div>Vigilancia</div>
    <div class="legend-item"><div class="legend-dot sem-rojo" role="img" aria-label="triángulo rojo"></div>Fuera de banda</div>
    <div class="legend-item"><div class="legend-dot sem-neutro" role="img" aria-label="cuadrado gris"></div>Sin umbral</div>
  </div>
  <div class="indic-list">
    {% for ind in publicados %}
    <div class="indic-row{% if ind.is_priority %} indic-priority alerta-{{ ind.alerta }}{% endif %}">
      <div class="semaforo sem-{{ ind.alerta }}" role="img" aria-label="Estado: {{ {'verde':'En parámetro','amarillo':'Vigilancia','rojo':'Fuera de banda','neutro':'Sin umbral'}[ind.alerta] if ind.alerta in ['verde','amarillo','rojo','neutro'] else ind.alerta }}"></div>
      <div class="indic-body">
        <div class="indic-nombre">{{ ind.nombre }}</div>
        <div class="indic-meta">
          <span>{{ ind.categoria | capitalize }}{% if ind.frecuencia %} · {{ ind.frecuencia | capitalize }}{% endif %}{% if ind.periodo_ref %} · {{ ind.periodo_ref }}{% endif %}</span>
          {% if ind.fecha_pub %}<span class="indic-meta-pub">Publicado {{ ind.fecha_pub }}</span>{% endif %}
        </div>
        {% if ind.contexto %}
        <div class="indic-context">{{ ind.contexto }}</div>
        {% endif %}
      </div>
      <div class="indic-vals">
        {% if ind.stat_valor_num != '—' %}
        <div class="indic-valor">{{ ind.stat_valor_num }}</div>
        <div class="indic-unidad">{{ ind.unidad_corta }}</div>
        {% if ind.stat_delta and ind.stat_delta != '—' %}
        <div class="indic-delta {{ 'delta-pos' if ind.delta_sign == '+' else 'delta-neg' if ind.delta_sign == '-' else 'delta-neu' }}">{{ ind.stat_delta }}</div>
        {% endif %}
        {% else %}
        <div class="indic-valor" style="font-size:14px;color:#71717A;font-weight:500">Vista<br>tabular</div>
        {% endif %}
        {% if ind.sparkline_svg %}
        <div class="indic-spark">{{ ind.sparkline_svg | safe }}</div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# Próximas publicaciones con agrupación temporal #}
  {% if proximas_grupos %}
  <div class="section-label" style="margin-top:4px">Próximas publicaciones · {{ proximas | length }} en los próximos 14 días</div>
  <div class="proximas-grupos">
    {% for grupo in proximas_grupos %}
    <div>
      <div class="prox-grupo-label">{{ grupo.label }}</div>
      <div class="proximas-grid">
        {% for p in grupo.publicaciones %}
        <div class="prox-card">
          <div class="prox-fecha">{{ p.fecha_display }}</div>
          <div class="prox-nombre">{{ p.nombre }}</div>
          <div class="prox-freq">{{ p.frecuencia | capitalize }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <footer class="rpt-footer">
    <span>Panorama MX · datos BIE-INEGI vía API oficial · interpretaciones con IA</span>
    <span>Build {{ build_fecha }} · La interpretación no es posición oficial</span>
  </footer>

</div>
</body>
</html>
